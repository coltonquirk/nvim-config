# Handle spaces and backslashes
context "math()"
snippet "([^\\\\])(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega)" "Add backslash before Greek letters" rmA
`!p snip.rv = match.group(1)`\\`!p snip.rv = match.group(2)`
endsnippet

context "math()"
snippet "([^\\\\])(hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree)" "Add backslash before symbols" rmA
`!p snip.rv = match.group(1)`\\`!p snip.rv = match.group(2)`
endsnippet

# Insert space after Greek letter and symbols
context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree|leq|geq|neq|times|cdot|circ|pm|mp|cup|cap|subset|supset|equiv|simeq|propto|parallel|oplus|otimes|wedge|vee)([A-Za-z])" "" rmA
\\`!p snip.rv = match.group(1)` `!p snip.rv = match.group(2)`
endsnippet

context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree) sr" "" rmA
\\`!p snip.rv = match.group(1)`^{2}
endsnippet

context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree) cb" "" rmA
\\`!p snip.rv = match.group(1)`^{3}
endsnippet

context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree) rd" "" rmA
\\`!p snip.rv = match.group(1)`^{$1}$2
endsnippet

context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree) hat" "" rmA
\\hat{\\`!p snip.rv = match.group(1)`}
endsnippet

context "math()"
snippet "\\\\(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|iota|kappa|lambda|mu|nu|xi|omicron|pi|rho|sigma|tau|upsilon|phi|chi|psi|omega|Gamma|Delta|Theta|Lambda|Xi|Pi|Sigma|Upsilon|Phi|Psi|Omega|hbar|ell|nabla|partial|infty|forall|exists|emptyset|perp|angle|degree) dot" "" rmA
