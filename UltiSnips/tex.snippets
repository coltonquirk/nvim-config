global !p 
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'
endglobal


snippet fig "Creates a figure" tA 
\\begin{figure}[htbp!]
	\\centering
	\\includegraphics[width=${1:0.5}\linewidth]{$2}
	\\caption{${3:Caption}}
	\\label{fig:${4:placeholder}}
\\end{figure}

$0
endsnippet

context "math()" 
snippet ff "This \frac{}{} snippet expands only in a LaTeX math context" mA
\frac{$1}{$2}$0
endsnippet

# Math mode
snippet mk "" tA
\$ $1 \$ $0
endsnippet

snippet dm "" tAw
\$\$
    $1
\$\$

$0
endsnippet

