\\left[ $1 \\right] $2
endsnippet

context "math()"
snippet lr| "" mA
\\left| $1 \\right| $2
endsnippet

context "math()"
snippet lra "" mA
\\left< $1 \\right> $2
endsnippet

# Snippet replacements can have placeholders.
context "math()"
snippet tayl "Taylor expansion" mA
${1:f}(${2:x} + ${3:h}) = ${1:f}(${2:x}) + ${1:f}'(${2:x})${3:h} + ${1:f}''(${2:x}) \\frac{${3:h}^{2}}{2!} + \\dots$4
endsnippet

context "math()"
snippet "iden(\d)" "N x N identity matrix" rmA
`!p 
n = int(match.group(1))
rows = []
for j in range(n):
	rows.append(" & ".join("1" if i == j else "0" for i in range(n)))
snip.rv = "\\begin{pmatrix}\n" + " \\\\\n".join(rows) + "\n\\end{pmatrix}"
`
endsnippet
