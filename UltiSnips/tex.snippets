# Trigonometry
context "math()"
snippet "([^\\])(arcsin|sin|arccos|cos|arctan|tan|csc|sec|cot)" "Add backslash before trig funcs" rmA
`!p snip.rv = match.group(1)`\\`!p snip.rv = match.group(2)`
endsnippet

context "math()"
snippet "\\(arcsin|sin|arccos|cos|arctan|tan|csc|sec|cot)([A-Za-gi-z])" "Add space after trig funcs. Skips letter h to allow sinh, cosh, etc." rmA
\\`!p snip.rv = match.group(1)` `!p snip.rv = match.group(2)`
endsnippet

context "math()"
snippet "\\(sinh|cosh|tanh|coth)([A-Za-z])" "Add space after hyperbolic trig funcs" rmA
context "math()"
\\`!p snip.rv = match.group(1)` `!p snip.rv = match.group(2)`
endsnippet

